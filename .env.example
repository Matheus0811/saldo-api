# Copie para ".env" se quiser mudar algo. Sem este arquivo a API funciona com os padrões.

# Porta local
PORT=3333

# Deixe vazio para usar o PGlite (PostgreSQL embutido, não precisa instalar nada).
# Para usar um PostgreSQL de verdade: postgresql://usuario:senha@localhost:5432/saldo
DATABASE_URL=

# Chave para assinar os tokens. Em produção use algo longo e aleatório:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-troque-antes-de-publicar-0123456789

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# true = cria a conta de demonstração (demo@saldo.dev / demo123) ao iniciar
SEED_DEMO=true
